# Copy this file to `.streamlit/secrets.toml` and fill in your own values.
# `secrets.toml` is git-ignored -- never commit real keys.
# On Streamlit Cloud, add the same keys under App -> Settings -> Secrets.

# --- AI writing assistant (OpenRouter, OpenAI-compatible) ---------------------
# Free key from https://openrouter.ai/keys
OPENROUTER_API_KEY = "sk-or-your-key-here"
# Optional overrides:
# OPENROUTER_MODEL = "tencent/hy3:free"
# OPENROUTER_BASE_URL = "https://openrouter.ai/api/v1"

# --- Job search (Adzuna) ------------------------------------------------------
# Free App ID + App Key from https://developer.adzuna.com/ (create an app).
# Without these the Jobs page still returns remote roles via Remotive (no key).
ADZUNA_APP_ID = "your-app-id"
ADZUNA_APP_KEY = "your-app-key"
